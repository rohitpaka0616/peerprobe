# No configuration needed for the local, persistent two-student demo.
# For Supabase mode, set all three, run the migration, then seed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only enable the demo on your own machine. Never use it on a public deployment.
PEERPROBE_LOCAL_DEMO=true
